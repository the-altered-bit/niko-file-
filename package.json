{
  "name": "niko-files",
  "version": "2.2.0",
  "description": "Niko Files — a fast, beautiful file explorer for Linux with a built-in terminal.",
  "main": "src/main.js",
  "author": "You",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.nikofiles.app",
    "productName": "Niko Files",
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility",
      "icon": "src/assets/icon.png"
    }
  }
}
